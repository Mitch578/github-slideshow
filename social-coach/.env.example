# Copy to .env and fill in to switch the app from mock AI to the real backend.
# Only these two values ever ship in the app. Never put the Anthropic key here.
EXPO_PUBLIC_SUPABASE_URL=
# anon key (legacy) or publishable key, both are public by design
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional until the pages exist
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
